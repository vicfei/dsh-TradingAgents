    "node": "^20.19.0 || >=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "files": [
    "bin",
    "skills",
    "scripts",
    "templates",
    "data",
    "cordis.patch.yml",
    "build.mjs",
    "LICENSE"
  ],
  "keywords": [
